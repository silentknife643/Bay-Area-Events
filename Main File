<h1>Bay Area, for me</h1><div class="sub" id="sub"></div>
<div class="tabs" id="tabs"></div><div id="list"></div>
<h2 id="nvh" hidden>New venues showing up</h2><div id="nv"></div>
<footer><p id="hid"></p><details><summary>Source issues</summary><ul id="rep"></ul></details></footer>
<script id="d" type="application/json">__DATA__</script>
<script>
const D=JSON.parse(document.getElementById('d').textContent);
const LS=(k,v)=>{try{if(v===undefined)return JSON.parse(localStorage.getItem(k)||'null');localStorage.setItem(k,JSON.stringify(v))}catch(e){return null}};
let hidden=new Set(LS('hiddenVenues')||[]),kind='all';const PER=10;
const el=(t,c,x)=>{const n=document.createElement(t);if(c)n.className=c;if(x!==undefined)n.textContent=x;return n};
const names={all:'All',music:'Music',film:'Film',exhibit:'Exhibits',reading:'Readings',theater:'Theater'};
function save(){LS('hiddenVenues',[...hidden]);render()}
function render(){
  document.getElementById('sub').textContent=`Near ${D.zip} · updated ${D.built}`;
  const tabs=document.getElementById('tabs');tabs.replaceChildren();
  for(const k in names){const b=el('button',k===kind?'on':'',names[k]);b.onclick=()=>{kind=k;render()};tabs.append(b)}
  const list=document.getElementById('list');list.replaceChildren();
  const ev=D.events.filter(e=>!hidden.has(e.venue)&&(kind==='all'||e.kind===kind));
  let lo=0;
  D.tiers.forEach((hi,i)=>{
    const g=ev.filter(e=>e.miles>lo&&e.miles<=hi||(i===0&&e.miles<=hi)).slice(0,PER).sort((a,b)=>a.date.localeCompare(b.date));
    list.append(el('h2','',i===0?`Within ${hi} miles`:`${lo}–${hi} miles`));
    if(!g.length)list.append(el('div','meta','Nothing matching.'));
    for(const e of g){
      const d=el('div','ev'),r=el('div','row'),l=el('div');
      const a=el('a','',e.title);if(e.url)a.href=e.url;l.append(a);
      l.append(el('div','meta',`${new Date(e.date+'T12:00').toLocaleDateString(undefined,{weekday:'short',month:'short',day:'numeric'})} · ${e.venue} · ${e.miles} mi`));
      if(e.why.length){const w=el('div','why','Matches: ');w.append(el('b','',e.why.join(', ')));l.append(w)}
      const b=el('button','','Not interested');b.title='Hide this venue';b.onclick=()=>{hidden.add(e.venue);save()};
      r.append(l,b);d.append(r);list.append(d)}
    lo=hi});
  const nv=document.getElementById('nv');nv.replaceChildren();
  document.getElementById('nvh').hidden=!D.new_venues.length;
  D.new_venues.filter(v=>!hidden.has(v)).forEach(v=>nv.append(el('div','meta',v)));
  const h=document.getElementById('hid');h.replaceChildren();
  if(hidden.size){h.append('Hidden venues: ');[...hidden].forEach(v=>{const b=el('button','',v+' ✕');b.style.marginRight='4px';b.onclick=()=>{hidden.delete(v);save()};h.append(b)})}
  const rep=document.getElementById('rep');rep.replaceChildren();D.report.forEach(r=>rep.append(el('li','',r)));
}
render();
</script></body></html>
