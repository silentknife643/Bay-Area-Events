#!/usr/bin/env python3
"""Builds docs/index.html: a taste-ranked, distance-grouped Bay Area events page."""
import json, math, os, re, time, datetime as dt
from pathlib import Path
import requests, yaml

ROOT = Path(__file__).parent
CFG = yaml.safe_load((ROOT / "config.yaml").read_text())
TODAY = dt.date.today()
HORIZON = TODAY + dt.timedelta(days=CFG["days_ahead"])
HOME = (CFG["home"]["lat"], CFG["home"]["lon"])
UA = {"User-Agent": "Mozilla/5.0 (personal event directory)"}
KINDS = {"Music": "music", "Film": "film", "Arts & Theatre": "theater"}

def miles(a, b):
    p1, p2 = math.radians(a[0]), math.radians(b[0])
    h = math.sin((p2 - p1) / 2) ** 2 + math.cos(p1) * math.cos(p2) * math.sin(math.radians(b[1] - a[1]) / 2) ** 2
    return 3959 * 2 * math.asin(math.sqrt(h))

def to_date(s):
    try: return dt.date.fromisoformat(str(s)[:10])
    except ValueError: return None

# ---------- sources ----------
def walk_events(node):
    if isinstance(node, list):
        for n in node: yield from walk_events(n)
    elif isinstance(node, dict):
        t = node.get("@type", "")
        types = t if isinstance(t, list) else [t]
        if any(str(x).endswith("Event") for x in types) and node.get("startDate"):
            yield node
        for v in node.values():
            if isinstance(v, (list, dict)): yield from walk_events(v)

def parse_jsonld(html):
    out = []
    for blob in re.findall(r'<script[^>]+ld\+json[^>]*>(.*?)</script>', html, re.S | re.I):
        try: data = json.loads(blob)
        except ValueError: continue
        for e in walk_events(data):
            out.append({"title": str(e.get("name", "")).strip(), "date": to_date(e["startDate"]),
                        "url": e.get("url", ""), "desc": str(e.get("description", ""))[:400]})
    return out

def parse_ics(text):
    text = re.sub(r"\r?\n[ \t]", "", text)
    out = []
    for block in text.split("BEGIN:VEVENT")[1:]:
        f = {m.group(1): m.group(2) for m in re.finditer(r"^([A-Z-]+)[^:\n]*:(.*)$", block, re.M)}
        d = re.match(r"(\d{4})(\d{2})(\d{2})", f.get("DTSTART", ""))
        if d: out.append({"title": f.get("SUMMARY", "").strip(), "date": dt.date(*map(int, d.groups())),
                          "url": f.get("URL", ""), "desc": f.get("DESCRIPTION", "")[:400]})
    return out

def scrape_venue(v):
    r = requests.get(v["url"], headers=UA, timeout=20); r.raise_for_status()
    raw = parse_ics(r.text) if v["type"] == "ics" else parse_jsonld(r.text)
    return [{**e, "venue": v["name"], "lat": v["lat"], "lon": v["lon"], "kind": v["kind"],
             "vweight": v["weight"], "source": "venue"} for e in raw if e["title"]]

def ticketmaster(key, params):
    r = requests.get("https://app.ticketmaster.com/discovery/v2/events.json", timeout=20, params={
        "apikey": key, "latlong": f"{HOME[0]},{HOME[1]}", "radius": CFG["max_miles"], "unit": "miles",
        "size": 50, "sort": "date,asc", "startDateTime": TODAY.isoformat() + "T00:00:00Z",
        "endDateTime": HORIZON.isoformat() + "T23:59:59Z", **params})
    r.raise_for_status()
    return r.json().get("_embedded", {}).get("events", [])

def tm_normalize(e):
    vs = (e.get("_embedded", {}).get("venues") or [{}])[0]
    loc = vs.get("location", {})
    if not loc.get("latitude"): return None
    seg = (e.get("classifications") or [{}])[0].get("segment", {}).get("name", "")
    return {"title": e["name"], "date": to_date(e["dates"]["start"].get("localDate")), "url": e.get("url", ""),
            "desc": "", "venue": vs.get("name", ""), "lat": float(loc["latitude"]), "lon": float(loc["longitude"]),
            "kind": KINDS.get(seg, "music"), "vweight": 0, "source": "ticketmaster",
            "attractions": [a["name"].lower() for a in e.get("_embedded", {}).get("attractions", [])]}

def fetch_all(report):
    events = []
    for v in CFG["venues"]:
        try:
            got = scrape_venue(v)
            events += got
            if not got: report.append(f"{v['name']}: page loaded but no structured events found (fix url/type in config.yaml)")
        except Exception as ex:
            report.append(f"{v['name']}: {type(ex).__name__}")
    key = os.environ.get("TICKETMASTER_KEY")
    if not key:
        report.append("Ticketmaster: TICKETMASTER_KEY not set, concert search skipped"); return events
    names = [str(n) for n in CFG["artists"]["top"] + CFG["artists"]["more"]]
    try:
        raw = [e for n in names for e in (time.sleep(0.25) or ticketmaster(key, {"keyword": n}))]
        raw += ticketmaster(key, {"classificationName": "classical"})
    except Exception as ex:
        report.append(f"Ticketmaster: {type(ex).__name__}"); return events
    for e in raw:
        n = tm_normalize(e)
        if n: events.append(n)
    return events

# ---------- scoring ----------
def score(e):
    text = f"{e['title']} {e.get('desc','')}".lower()
    why, s = [], e["vweight"]
    for i, a in enumerate(map(str, CFG["artists"]["top"] + CFG["artists"]["more"])):
        a_l = a.lower()
        if a_l in e.get("attractions", []) or (e["source"] == "venue" and a_l in text):
            s += 12 if i < len(CFG["artists"]["top"]) else 8; why.append(a); break
    for k in CFG["keywords"].get(e["kind"], []) + CFG["keywords"]["music"] * (e["kind"] == "theater"):
        if k.lower() in text: s += 5; why.append(k); break
    e["miles"] = round(miles(HOME, (e["lat"], e["lon"])), 1)
    e["score"] = round(s - min(e["miles"] * 0.05, 3), 2)
    e["why"] = why
    return e

def build():
    report = []
    events = fetch_all(report)
    seen, pool = set(), []
    for e in map(score, events):
        d = e["date"]
        k = (e["title"].lower(), str(d), e["venue"].lower())
        if not d or not (TODAY <= d <= HORIZON) or k in seen or e["miles"] > CFG["max_miles"]: continue
        if e["source"] == "ticketmaster" and not e["why"]: continue   # only keep concerts that match your taste
        seen.add(k)
        pool.append({"title": e["title"], "date": str(d), "url": e["url"], "venue": e["venue"], "kind": e["kind"],
                     "miles": e["miles"], "score": e["score"], "why": e["why"]})
    pool.sort(key=lambda e: -e["score"])
    pool = pool[:400]
    # new-venue detection (no LLM needed): venues seen via Ticketmaster that we haven't seen before
    state_f = ROOT / "docs" / "seen_venues.json"
    known = set(json.loads(state_f.read_text())) if state_f.exists() else None
    names = {e["venue"] for e in pool}
    new = sorted(names - known - {v["name"] for v in CFG["venues"]}) if known is not None else []
    state_f.write_text(json.dumps(sorted((known or set()) | names)))
    html = (ROOT / "template.html").read_text().replace("__DATA__", json.dumps({
        "events": pool, "tiers": CFG["tiers"], "zip": CFG["home"]["zip"], "new_venues": new,
        "report": report, "built": TODAY.isoformat()}).replace("</", "<\\/"))
    (ROOT / "docs" / "index.html").write_text(html)
    print(f"{len(pool)} events, {len(report)} source issues, {len(new)} new venues")

if __name__ == "__main__":
    build()

